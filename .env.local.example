# Frontend (Next.js) — chat-bullq-web
# Copie pra .env.local e preencha.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── WhatsApp Embedded Signup (Tech Provider) ───────────────────────────────
# Preencher quando a Business Verification da Meta for aprovada e o
# Embedded Signup tiver config_id. Enquanto vazio, o botão "Conectar
# WhatsApp (automático)" mostra aviso e o usuário cai no formulário manual.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
